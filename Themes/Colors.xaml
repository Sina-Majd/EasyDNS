<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 2026 Dark Modern Palette (Matte Slate / Luxury Dark) -->
    <Color x:Key="ColorBackgroundDark">#0A0B10</Color>
    <Color x:Key="ColorTitleBarBackground">#0F1119</Color>
    <Color x:Key="ColorPanelDark">#11141E</Color>
    <Color x:Key="ColorCardBackground">#141723</Color>
    <Color x:Key="ColorCardHover">#1B1F2F</Color>
    <Color x:Key="ColorCardSelected">#1C223A</Color>
    <Color x:Key="ColorInputBackground">#0D0F17</Color>

    <!-- Accents & Borders -->
    <Color x:Key="ColorBorder">#222638</Color>
    <Color x:Key="ColorBorderHighlight">#6366F1</Color>
    <Color x:Key="ColorAccentPrimary">#4F46E5</Color>
    <Color x:Key="ColorAccentPrimaryHover">#6366F1</Color>
    <Color x:Key="ColorAccentSuccess">#10B981</Color>
    <Color x:Key="ColorAccentSuccessHover">#34D399</Color>
    <Color x:Key="ColorAccentWarning">#F59E0B</Color>
    <Color x:Key="ColorAccentDanger">#F43F5E</Color>
    <Color x:Key="ColorAccentDangerHover">#FB7185</Color>
    <Color x:Key="ColorAccentCyan">#06B6D4</Color>

    <!-- Window Controls -->
    <Color x:Key="ColorWindowBtnHover">#202536</Color>
    <Color x:Key="ColorCloseBtnHover">#E11D48</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextAccent">#818CF8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource ColorBackgroundDark}" />
    <SolidColorBrush x:Key="BrushTitleBarBackground" Color="{StaticResource ColorTitleBarBackground}" />
    <SolidColorBrush x:Key="BrushPanelDark" Color="{StaticResource ColorPanelDark}" />
    <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorCardBackground}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushCardSelected" Color="{StaticResource ColorCardSelected}" />
    <SolidColorBrush x:Key="BrushInputBackground" Color="{StaticResource ColorInputBackground}" />

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryHover" Color="{StaticResource ColorAccentPrimaryHover}" />
    <SolidColorBrush x:Key="BrushAccentSuccess" Color="{StaticResource ColorAccentSuccess}" />
    <SolidColorBrush x:Key="BrushAccentSuccessHover" Color="{StaticResource ColorAccentSuccessHover}" />
    <SolidColorBrush x:Key="BrushAccentWarning" Color="{StaticResource ColorAccentWarning}" />
    <SolidColorBrush x:Key="BrushAccentDanger" Color="{StaticResource ColorAccentDanger}" />
    <SolidColorBrush x:Key="BrushAccentDangerHover" Color="{StaticResource ColorAccentDangerHover}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />

    <SolidColorBrush x:Key="BrushWindowBtnHover" Color="{StaticResource ColorWindowBtnHover}" />
    <SolidColorBrush x:Key="BrushCloseBtnHover" Color="{StaticResource ColorCloseBtnHover}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextAccent" Color="{StaticResource ColorTextAccent}" />

    <!-- ScrollBar Colors (Refined Matte Bar, matching original) -->
    <Color x:Key="ColorScrollTrack">#101622</Color>
    <Color x:Key="ColorScrollThumb">#303650</Color>
    <Color x:Key="ColorScrollThumbHover">#4F587D</Color>
    <Color x:Key="ColorScrollThumbDragging">#6366F1</Color>

    <SolidColorBrush x:Key="BrushScrollTrack" Color="{StaticResource ColorScrollTrack}" />
    <SolidColorBrush x:Key="BrushScrollThumb" Color="{StaticResource ColorScrollThumb}" />
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="{StaticResource ColorScrollThumbHover}" />
    <SolidColorBrush x:Key="BrushScrollThumbDragging" Color="{StaticResource ColorScrollThumbDragging}" />

</ResourceDictionary>
